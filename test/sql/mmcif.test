# A missing category is not exposed
statement error
SELECT * FROM nonexistent_table;
----
Catalog Error: Table with name nonexistent_table does not exist!

# A partial trailing loop row is read, with its missing values as NULL
statement ok
COPY (SELECT 'data_p' || chr(10) || 'loop_' || chr(10) || '_p.a' || chr(10) || '_p.b' || chr(10) || '1 2' || chr(10) || '3') TO '__TEST_DIR__/mmcif_partial.cif' (FORMAT CSV, HEADER 0, QUOTE '');

query II
SELECT * FROM mmcif_scan('__TEST_DIR__/mmcif_partial.cif', 'p');
----
1	2
3	NULL

statement ok
ATTACH '__TEST_DIR__/mmcif_partial.cif' AS partial (TYPE mmcif);

query I
SELECT count(*) FROM partial.p;
----
2

statement ok
DETACH partial

# ---------------------------------------------------------------------------
# Write mode: ATTACH ... (READ_WRITE TRUE) enables row-level
# INSERT/UPDATE/DELETE, with write-back on COMMIT and ROLLBACK discarding.
# ---------------------------------------------------------------------------

# Write mode cannot create a file: attaching a missing one fails like read-only does.
statement error
ATTACH '__TEST_DIR__/mmcif_missing.cif' AS missing (TYPE mmcif, READ_WRITE TRUE);
----
IO Error: mmcif: file not found

# Create a small writable cif fixture inside the test temp dir
statement ok
COPY (SELECT t FROM (VALUES ('data_test'), ('loop_'), ('_atom_site.label_atom_id'), ('_atom_site.Cartn_x'), ('_atom_site.type_symbol'), ('C1'), ('1.5'), ('C'), ('N1'), ('2.5'), ('N')) AS v(t)) TO '__TEST_DIR__/mmcif_write.cif' (FORMAT CSV, HEADER 0);

statement ok
ATTACH '__TEST_DIR__/mmcif_write.cif' AS wdb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE wdb;

# Writable attachments expose the same catalog comments.
query TT
SELECT table_name, comment FROM duckdb_tables() WHERE database_name='wdb';
----
atom_site	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/atom_site.html

query TT
SELECT column_name, comment FROM duckdb_columns() WHERE database_name='wdb' AND table_name='atom_site' ORDER BY column_index;
----
label_atom_id	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.label_atom_id.html
Cartn_x	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.Cartn_x.html
type_symbol	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.type_symbol.html

# Initial contents
query I
SELECT count(*) FROM atom_site;
----
2

query TT
SELECT label_atom_id, Cartn_x FROM atom_site ORDER BY label_atom_id;
----
C1	1.5
N1	2.5

# All DML inside one explicit transaction; COMMIT writes back to the .cif
statement ok
BEGIN;

# INSERT appends a row (row_id == physical row index)
statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x, type_symbol) VALUES ('O1', 3.5, 'O');

query I
SELECT count(*) FROM atom_site;
----
3

# UPDATE mutates in place
statement ok
UPDATE atom_site SET type_symbol='ZZ' WHERE label_atom_id='O1';

query T
SELECT type_symbol FROM atom_site WHERE label_atom_id='O1';
----
ZZ

# DELETE removes a row
statement ok
DELETE FROM atom_site WHERE label_atom_id='O1';

query I
SELECT count(*) FROM atom_site;
----
2

# COMMIT persists the mutations to the .cif file
statement ok
COMMIT;

# ROLLBACK discards in-memory mutations by re-parsing from disk
statement ok
BEGIN;

statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x, type_symbol) VALUES ('O2', 4.5, 'O');

query I
SELECT count(*) FROM atom_site;
----
3

statement ok
ROLLBACK;

query I
SELECT count(*) FROM atom_site;
----
2

# Re-attach in a fresh database: committed changes are still there
statement ok
USE memory;

statement ok
DETACH wdb;

statement ok
ATTACH '__TEST_DIR__/mmcif_write.cif' AS rdb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE rdb;

query I
SELECT count(*) FROM atom_site;
----
2

query TT
SELECT label_atom_id, Cartn_x FROM atom_site ORDER BY label_atom_id;
----
C1	1.5
N1	2.5

# ---------------------------------------------------------------------------
# DELETE regressions: row ids refer to positions in the table at scan time,
# so all matched ids of a statement must be applied once against the original
# table. Applying them per sink chunk used stale indices after the first
# shrink ("Invalid row index in ISTable::CacheRowLocation"), and a second
# combine pass reused stale accumulated ids.
# ---------------------------------------------------------------------------

statement ok
USE memory;

# Fixture with one more row than STANDARD_VECTOR_SIZE so DELETEs span chunks
statement ok
COPY (SELECT t FROM (VALUES ('data_test'), ('loop_'), ('_atom_site.label_atom_id'), ('_atom_site.Cartn_x'), ('KEEP'), ('0.0')) AS v(t)) TO '__TEST_DIR__/mmcif_delete.cif' (FORMAT CSV, HEADER 0);

statement ok
ATTACH '__TEST_DIR__/mmcif_delete.cif' AS ddb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE ddb;

statement ok
BEGIN;

statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x) SELECT 'r' || i, i FROM range(1, 5000) t(i);

query I
SELECT count(*) FROM atom_site;
----
5000

# Multi-chunk DELETE: previously threw "Invalid row index" on the second chunk
statement ok
DELETE FROM atom_site WHERE label_atom_id <> 'KEEP';

query I
SELECT count(*) FROM atom_site;
----
1

# Re-populate and delete through a subquery (MARK JOIN plan); the sink/combine
# of this plan shape runs more than once, so deletes must apply exactly once
statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x) SELECT 'r' || i, i FROM range(1, 5000) t(i);

statement ok
CREATE TEMP TABLE keep AS SELECT 'KEEP' AS lab;

statement ok
DELETE FROM atom_site WHERE label_atom_id NOT IN (SELECT lab FROM keep);

query I
SELECT count(*) FROM atom_site;
----
1

# COMMIT persists both deletes; re-attach and verify the final state
statement ok
COMMIT;

statement ok
USE memory;

statement ok
DETACH ddb;

statement ok
ATTACH '__TEST_DIR__/mmcif_delete.cif' AS rdd (TYPE mmcif);

statement ok
USE rdd;

query T
SELECT label_atom_id FROM atom_site;
----
KEEP

# ---------------------------------------------------------------------------
# Gzip round-trip: a .cif.gz attached in write mode must be written back gzip
# compressed (CifFile::Write itself always emits plain text).
# ---------------------------------------------------------------------------

statement ok
USE memory;

# COPY with a .gz target produces a gzip-compressed file
statement ok
COPY (SELECT t FROM (VALUES ('data_gz'), ('loop_'), ('_atom_site.label_atom_id'), ('_atom_site.Cartn_x'), ('G1'), ('1.5')) AS v(t)) TO '__TEST_DIR__/mmcif_gz.cif.gz' (FORMAT CSV, HEADER 0);

# The fixture really is gzip-compressed (gzip magic bytes)
query I
SELECT (lower(hex(content)) LIKE '1f8b%')::INT FROM read_blob('__TEST_DIR__/mmcif_gz.cif.gz');
----
1

statement ok
ATTACH '__TEST_DIR__/mmcif_gz.cif.gz' AS gdb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE gdb;

statement ok
BEGIN;

statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x) VALUES ('G2', 2.5);

statement ok
COMMIT;

statement ok
USE memory;

statement ok
DETACH gdb;

# Still gzip after the write-back
query I
SELECT (lower(hex(content)) LIKE '1f8b%')::INT FROM read_blob('__TEST_DIR__/mmcif_gz.cif.gz');
----
1

# ... and the category still round-trips with the inserted row
statement ok
ATTACH '__TEST_DIR__/mmcif_gz.cif.gz' AS rgdb (TYPE mmcif);

statement ok
USE rgdb;

query T
SELECT label_atom_id FROM atom_site ORDER BY label_atom_id;
----
G1
G2

# ---------------------------------------------------------------------------
# Comment retention: the write-back must put the '#' lines it read back where
# they belong instead of dropping them. A comment inside loop data no longer
# truncates the loop either, so the rows after it survive a write-back too.
# ---------------------------------------------------------------------------

statement ok
USE memory;

statement ok
COPY (SELECT t FROM (VALUES ('# file comment'), ('# second preamble line'), ('data_test'), ('# before the loop'), ('loop_'), ('_atom_site.label_atom_id'), ('_atom_site.Cartn_x'), ('C1'), ('1.5'), ('# between rows'), ('N1'), ('2.5'), ('# trailing comment')) AS v(t)) TO '__TEST_DIR__/mmcif_comments.cif' (FORMAT CSV, HEADER 0, QUOTE '');

# The fixture's comment lines, in file order
query I
SELECT line FROM (SELECT unnest(string_split(content, E'\n')) AS line FROM read_text('__TEST_DIR__/mmcif_comments.cif')) WHERE line LIKE '#%';
----
# file comment
# second preamble line
# before the loop
# between rows
# trailing comment

statement ok
ATTACH '__TEST_DIR__/mmcif_comments.cif' AS cmdb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE cmdb;

# The row below the in-loop comment is data, not a truncation
query TT
SELECT label_atom_id, Cartn_x FROM atom_site ORDER BY label_atom_id;
----
C1	1.5
N1	2.5

statement ok
BEGIN;

statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x) VALUES ('O1', 3.5);

statement ok
COMMIT;

# Every comment is still on disk, in the original order
query I
SELECT line FROM (SELECT unnest(string_split(content, E'\n')) AS line FROM read_text('__TEST_DIR__/mmcif_comments.cif')) WHERE line LIKE '#%';
----
# file comment
# second preamble line
# before the loop
# between rows
# trailing comment

# ... and each one still sits in front of what it annotated
query I
SELECT (starts_with(content, E'# file comment\n# second preamble line\ndata_test\n') AND contains(content, E'# before the loop\nloop_') AND contains(content, E'# between rows\nN1') AND ends_with(content, E'# trailing comment\n'))::INT
FROM read_text('__TEST_DIR__/mmcif_comments.cif');
----
1

# The write-back is still readable, with the inserted row appended
statement ok
USE memory;

statement ok
DETACH cmdb;

statement ok
ATTACH '__TEST_DIR__/mmcif_comments.cif' AS rcdb (TYPE mmcif);

query TT
SELECT label_atom_id, Cartn_x FROM rcdb.atom_site ORDER BY label_atom_id;
----
C1	1.5
N1	2.5
O1	3.5

# ROLLBACK re-materializes from disk, comments included
statement ok
USE rcdb;

statement ok
ATTACH '__TEST_DIR__/mmcif_comments.cif' AS wdb2 (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE wdb2;

statement ok
BEGIN;

statement ok
DELETE FROM atom_site WHERE label_atom_id <> 'C1';

statement ok
ROLLBACK;

statement ok
USE memory;

statement ok
DETACH wdb2;

query I
SELECT count(*) FROM (SELECT unnest(string_split(content, E'\n')) AS line FROM read_text('__TEST_DIR__/mmcif_comments.cif')) WHERE line LIKE '#%';
----
5

# ---------------------------------------------------------------------------
# Remote (http/https/s3/...) mmcif files are always read-only: attaching one
# with READ_WRITE TRUE is rejected. (A URL scheme that DuckDB core recognizes
# would first demand httpfs, so a non-core scheme is used here to exercise the
# extension's own guard without needing network access.)
# ---------------------------------------------------------------------------

statement ok
USE memory;

statement error
ATTACH 'weirdproto://x/y.cif' AS rdb (TYPE mmcif, READ_WRITE TRUE);
----
read-only

