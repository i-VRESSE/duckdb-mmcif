# name: test/sql/mmcif.test
# description: mmcif extension: ATTACH a cif data file and expose categories as tables
# group: [sql]

# Before the extension is loaded, the mmcif table functions do not exist
statement error
SELECT * FROM mmcif_tables('x.cif');
----
Catalog Error: Table Function with name mmcif_tables does not exist!

statement error
SELECT * FROM mmcif_relationships('x.cif');
----
Catalog Error: Table Function with name mmcif_relationships does not exist!

# Require statement will ensure this test is run with this extension loaded
require mmcif

# Global metadata table functions work without ATTACH
query I
SELECT count(*) FROM mmcif_tables('__WORKING_DIRECTORY__/test/data/1amb_updated.cif');
----
342

query III
SELECT table_name, column_name, column_type FROM mmcif_tables('__WORKING_DIRECTORY__/test/data/1amb_updated.cif') WHERE table_name='atom_site' ORDER BY column_name LIMIT 3;
----
atom_site	B_iso_or_equiv	DOUBLE
atom_site	Cartn_x	DOUBLE
atom_site	Cartn_y	DOUBLE

query I
SELECT count(*) FROM mmcif_relationships('__WORKING_DIRECTORY__/test/data/1amb_updated.cif');
----
86

query TTTT
SELECT parent_table, parent_column, child_table, child_column FROM mmcif_relationships('__WORKING_DIRECTORY__/test/data/1amb_updated.cif') WHERE parent_table='atom_site' ORDER BY child_table, child_column LIMIT 3;
----
atom_site	pdbx_PDB_ins_code	pdbx_validate_torsion	PDB_ins_code
atom_site	pdbx_PDB_model_num	pdbx_validate_torsion	PDB_model_num
atom_site	auth_asym_id	pdbx_validate_torsion	auth_asym_id

# ATTACH the cif file as an mmcif database
statement ok
ATTACH '__WORKING_DIRECTORY__/test/data/1amb_updated.cif' AS mmcifdb (TYPE mmcif);

statement ok
USE mmcifdb;

# SHOW TABLES lists every category present in the file
query T
SELECT table_name FROM duckdb_tables() WHERE database_name='mmcifdb' ORDER BY table_name LIMIT 3;
----
atom_site
atom_sites
atom_type

# The dictionary-driven column types come through the catalog
query TT
SELECT name, type FROM pragma_table_info('atom_site') WHERE name IN ('Cartn_x','label_seq_id','type_symbol') ORDER BY name;
----
Cartn_x	DOUBLE
label_seq_id	BIGINT
type_symbol	VARCHAR

# Scanning works: count(*), typed values, and filters
query I
SELECT count(*) FROM atom_site;
----
438

query I
SELECT count(*) FROM atom_site WHERE Cartn_x > 5;
----
155

query TT
SELECT Cartn_x, type_symbol FROM atom_site ORDER BY label_atom_id LIMIT 2;
----
17.882	C
16.209	C

# '.' and '?' cells map to NULL
query I
SELECT count(*) FROM atom_site WHERE label_alt_id IS NULL;
----
438

# mmcif_scan as a table function also works
query I
SELECT count(*) FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/1amb_updated.cif', 'atom_site');
----
438

# gzip'd mmcif files work the same way as uncompressed ones
query I
SELECT count(*) FROM mmcif_tables('__WORKING_DIRECTORY__/test/data/1amb_updated.cif.gz');
----
342

query I
SELECT count(*) FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/1amb_updated.cif.gz', 'atom_site');
----
438

query TT
SELECT Cartn_x, type_symbol FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/1amb_updated.cif.gz', 'atom_site') ORDER BY label_atom_id LIMIT 2;
----
17.882	C
16.209	C

statement ok
ATTACH '__WORKING_DIRECTORY__/test/data/1amb_updated.cif.gz' AS gzdb (TYPE mmcif);

statement ok
USE gzdb;

query I
SELECT count(*) FROM atom_site;
----
438

statement ok
USE mmcifdb;

# mmcif databases are read-only
statement error
CREATE TABLE foo(i int);
----
Binder Error: mmcif databases are read-only - cannot CREATE TABLE

statement error
DELETE FROM atom_site;
----
Binder Error: mmcif databases are read-only - cannot DELETE

statement error
UPDATE atom_site SET type_symbol='X';
----
Binder Error: mmcif databases are read-only - cannot UPDATE

# A missing category is not exposed
statement error
SELECT * FROM nonexistent_table;
----
Catalog Error: Table with name nonexistent_table does not exist!

# ---------------------------------------------------------------------------
# Write mode (issue 01/02): ATTACH ... (READ_WRITE TRUE) enables row-level
# INSERT/UPDATE/DELETE, with write-back on COMMIT and ROLLBACK discarding.
# ---------------------------------------------------------------------------

# Create a small writable cif fixture inside the test temp dir
statement ok
COPY (SELECT t FROM (VALUES ('data_test'), ('loop_'), ('_atom_site.label_atom_id'), ('_atom_site.Cartn_x'), ('_atom_site.type_symbol'), ('C1'), ('1.5'), ('C'), ('N1'), ('2.5'), ('N')) AS v(t)) TO '__TEST_DIR__/mmcif_write.cif' (FORMAT CSV, HEADER 0);

statement ok
ATTACH '__TEST_DIR__/mmcif_write.cif' AS wdb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE wdb;

# Initial contents
query I
SELECT count(*) FROM atom_site;
----
2

query TT
SELECT label_atom_id, Cartn_x FROM atom_site ORDER BY label_atom_id;
----
C1	1.5
N1	2.5

# All DML inside one explicit transaction; COMMIT writes back to the .cif
statement ok
BEGIN;

# INSERT appends a row (row_id == physical row index)
statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x, type_symbol) VALUES ('O1', 3.5, 'O');

query I
SELECT count(*) FROM atom_site;
----
3

# UPDATE mutates in place
statement ok
UPDATE atom_site SET type_symbol='ZZ' WHERE label_atom_id='O1';

query T
SELECT type_symbol FROM atom_site WHERE label_atom_id='O1';
----
ZZ

# DELETE removes a row
statement ok
DELETE FROM atom_site WHERE label_atom_id='O1';

query I
SELECT count(*) FROM atom_site;
----
2

# COMMIT persists the mutations to the .cif file
statement ok
COMMIT;

# ROLLBACK discards in-memory mutations by re-parsing from disk
statement ok
BEGIN;

statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x, type_symbol) VALUES ('O2', 4.5, 'O');

query I
SELECT count(*) FROM atom_site;
----
3

statement ok
ROLLBACK;

query I
SELECT count(*) FROM atom_site;
----
2

# Re-attach in a fresh database: committed changes are still there
statement ok
USE memory;

statement ok
DETACH wdb;

statement ok
ATTACH '__TEST_DIR__/mmcif_write.cif' AS rdb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE rdb;

query I
SELECT count(*) FROM atom_site;
----
2

query TT
SELECT label_atom_id, Cartn_x FROM atom_site ORDER BY label_atom_id;
----
C1	1.5
N1	2.5

# ---------------------------------------------------------------------------
# DELETE regressions: row ids refer to positions in the table at scan time,
# so all matched ids of a statement must be applied once against the original
# table. Applying them per sink chunk used stale indices after the first
# shrink ("Invalid row index in ISTable::CacheRowLocation"), and a second
# combine pass reused stale accumulated ids.
# ---------------------------------------------------------------------------

statement ok
USE memory;

# Fixture with one more row than STANDARD_VECTOR_SIZE so DELETEs span chunks
statement ok
COPY (SELECT t FROM (VALUES ('data_test'), ('loop_'), ('_atom_site.label_atom_id'), ('_atom_site.Cartn_x'), ('KEEP'), ('0.0')) AS v(t)) TO '__TEST_DIR__/mmcif_delete.cif' (FORMAT CSV, HEADER 0);

statement ok
ATTACH '__TEST_DIR__/mmcif_delete.cif' AS ddb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE ddb;

statement ok
BEGIN;

statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x) SELECT 'r' || i, i FROM range(1, 5000) t(i);

query I
SELECT count(*) FROM atom_site;
----
5000

# Multi-chunk DELETE: previously threw "Invalid row index" on the second chunk
statement ok
DELETE FROM atom_site WHERE label_atom_id <> 'KEEP';

query I
SELECT count(*) FROM atom_site;
----
1

# Re-populate and delete through a subquery (MARK JOIN plan); the sink/combine
# of this plan shape runs more than once, so deletes must apply exactly once
statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x) SELECT 'r' || i, i FROM range(1, 5000) t(i);

statement ok
CREATE TEMP TABLE keep AS SELECT 'KEEP' AS lab;

statement ok
DELETE FROM atom_site WHERE label_atom_id NOT IN (SELECT lab FROM keep);

query I
SELECT count(*) FROM atom_site;
----
1

# COMMIT persists both deletes; re-attach and verify the final state
statement ok
COMMIT;

statement ok
USE memory;

statement ok
DETACH ddb;

statement ok
ATTACH '__TEST_DIR__/mmcif_delete.cif' AS rdd (TYPE mmcif);

statement ok
USE rdd;

query T
SELECT label_atom_id FROM atom_site;
----
KEEP

# ---------------------------------------------------------------------------
# Gzip round-trip: a .cif.gz attached in write mode must be written back gzip
# compressed (CifFile::Write itself always emits plain text).
# ---------------------------------------------------------------------------

statement ok
USE memory;

# COPY with a .gz target produces a gzip-compressed file
statement ok
COPY (SELECT t FROM (VALUES ('data_gz'), ('loop_'), ('_atom_site.label_atom_id'), ('_atom_site.Cartn_x'), ('G1'), ('1.5')) AS v(t)) TO '__TEST_DIR__/mmcif_gz.cif.gz' (FORMAT CSV, HEADER 0);

# The fixture really is gzip-compressed (gzip magic bytes)
query I
SELECT (lower(hex(content)) LIKE '1f8b%')::INT FROM read_blob('__TEST_DIR__/mmcif_gz.cif.gz');
----
1

statement ok
ATTACH '__TEST_DIR__/mmcif_gz.cif.gz' AS gdb (TYPE mmcif, READ_WRITE TRUE);

statement ok
USE gdb;

statement ok
BEGIN;

statement ok
INSERT INTO atom_site (label_atom_id, Cartn_x) VALUES ('G2', 2.5);

statement ok
COMMIT;

statement ok
USE memory;

statement ok
DETACH gdb;

# Still gzip after the write-back
query I
SELECT (lower(hex(content)) LIKE '1f8b%')::INT FROM read_blob('__TEST_DIR__/mmcif_gz.cif.gz');
----
1

# ... and the category still round-trips with the inserted row
statement ok
ATTACH '__TEST_DIR__/mmcif_gz.cif.gz' AS rgdb (TYPE mmcif);

statement ok
USE rgdb;

query T
SELECT label_atom_id FROM atom_site ORDER BY label_atom_id;
----
G1
G2

# ---------------------------------------------------------------------------
# Remote (http/https/s3/...) mmcif files are always read-only: attaching one
# with READ_WRITE TRUE is rejected. (A URL scheme that DuckDB core recognizes
# would first demand httpfs, so a non-core scheme is used here to exercise the
# extension's own guard without needing network access.)
# ---------------------------------------------------------------------------

statement ok
USE memory;

statement error
ATTACH 'weirdproto://x/y.cif' AS rdb (TYPE mmcif, READ_WRITE TRUE);
----
read-only
