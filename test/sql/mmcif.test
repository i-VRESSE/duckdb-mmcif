# name: test/sql/mmcif.test
# description: mmcif extension: ATTACH a cif data file and expose categories as tables
# group: [sql]

# Before the extension is loaded, the mmcif table functions do not exist
statement error
SELECT * FROM mmcif_columns('x.cif');
----
Catalog Error: Table Function with name mmcif_columns does not exist!

statement error
SELECT * FROM mmcif_tables('x.cif');
----
Catalog Error: Table Function with name mmcif_tables does not exist!

statement error
SELECT * FROM mmcif_relationships('x.cif');
----
Catalog Error: Table Function with name mmcif_relationships does not exist!

# Require statement will ensure this test is run with this extension loaded
require mmcif

# The extension's table functions are discoverable through duckdb_functions():
# each carries a description, real parameter names, an example and the mmcif
# category.
query TTT
SELECT function_name, parameters, parameter_types FROM duckdb_functions() WHERE function_name LIKE 'mmcif%' ORDER BY function_name;
----
mmcif_columns	[file]	[VARCHAR]
mmcif_relationships	[file]	[VARCHAR]
mmcif_scan	[file, table]	[VARCHAR, VARCHAR]
mmcif_tables	[file]	[VARCHAR]

query TIII
SELECT function_name, (description IS NOT NULL)::INT, len(examples), len(categories)
FROM duckdb_functions() WHERE function_name LIKE 'mmcif%' ORDER BY function_name;
----
mmcif_columns	1	1	1
mmcif_relationships	1	1	1
mmcif_scan	1	1	1
mmcif_tables	1	1	1

# Global metadata table functions work without ATTACH
query I
SELECT count(*) FROM mmcif_tables('__WORKING_DIRECTORY__/test/data/1amb_updated.cif');
----
43

query TTI
SELECT table_name, comment, column_count FROM mmcif_tables('__WORKING_DIRECTORY__/test/data/1amb_updated.cif') WHERE table_name='atom_site';
----
atom_site	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/atom_site.html	21

query I
SELECT count(*) FROM mmcif_columns('__WORKING_DIRECTORY__/test/data/1amb_updated.cif');
----
342

query TTITT
SELECT table_name, column_name, column_index, comment, data_type FROM mmcif_columns('__WORKING_DIRECTORY__/test/data/1amb_updated.cif') WHERE table_name='atom_site' ORDER BY column_name LIMIT 3;
----
atom_site	B_iso_or_equiv	15	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.B_iso_or_equiv.html	DOUBLE
atom_site	Cartn_x	11	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.Cartn_x.html	DOUBLE
atom_site	Cartn_y	12	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.Cartn_y.html	DOUBLE

# Items missing from the local type index still receive their dictionary URL.
query T
SELECT comment FROM mmcif_columns('__WORKING_DIRECTORY__/test/data/1amb_updated.cif') WHERE table_name='atom_site' AND column_name='id';
----
https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.id.html

query I
SELECT count(*) FROM mmcif_relationships('__WORKING_DIRECTORY__/test/data/1amb_updated.cif');
----
86

query TTTT
SELECT parent_table, parent_column, child_table, child_column FROM mmcif_relationships('__WORKING_DIRECTORY__/test/data/1amb_updated.cif') WHERE parent_table='atom_site' ORDER BY child_table, child_column LIMIT 3;
----
atom_site	pdbx_PDB_ins_code	pdbx_validate_torsion	PDB_ins_code
atom_site	pdbx_PDB_model_num	pdbx_validate_torsion	PDB_model_num
atom_site	auth_asym_id	pdbx_validate_torsion	auth_asym_id

# ATTACH the cif file as an mmcif database
statement ok
ATTACH '__WORKING_DIRECTORY__/test/data/1amb_updated.cif' AS mmcifdb (TYPE mmcif);

statement ok
USE mmcifdb;

# Attached mmCIF columns expose their dictionary pages as catalog comments.
query TT
SELECT column_name, comment FROM duckdb_columns() WHERE database_name='mmcifdb' AND table_name='atom_site' AND column_name IN ('id', 'Cartn_x') ORDER BY column_index;
----
id	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.id.html
Cartn_x	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_atom_site.Cartn_x.html

# SHOW TABLES lists every category present in the file
query TT
SELECT table_name, comment FROM duckdb_tables() WHERE database_name='mmcifdb' ORDER BY table_name LIMIT 3;
----
atom_site	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/atom_site.html
atom_sites	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/atom_sites.html
atom_type	https://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/atom_type.html

# The dictionary-driven column types come through the catalog
query TT
SELECT name, type FROM pragma_table_info('atom_site') WHERE name IN ('Cartn_x','label_seq_id','type_symbol') ORDER BY name;
----
Cartn_x	DOUBLE
label_seq_id	BIGINT
type_symbol	VARCHAR

