# name: test/sql/mmcif_multifile.test
# description: Union categories across glob attachments and multi-file scans
# group: [sql]

require mmcif

statement ok
ATTACH '__WORKING_DIRECTORY__/test/data/multifile/*.cif' AS cifs (TYPE mmcif);

query T rowsort
SELECT table_name FROM duckdb_tables() WHERE database_name = 'cifs';
----
atom_site
entry
struct

# Case-insensitive union, reordered columns, and typed missing values.
query IRT rowsort
SELECT id, Cartn_x, type_symbol FROM cifs.atom_site;
----
1	1.5	NULL
2	2.5	NULL
3	NULL	O
4	NULL	N

query TI rowsort
SELECT regexp_extract(filename, '[^/]+$'), count(*) FROM cifs.atom_site GROUP BY filename;
----
a.cif	2
b.cif	2

query TT rowsort
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'cifs' AND table_name = 'atom_site';
----
Cartn_x	DOUBLE
filename	VARCHAR
id	VARCHAR
type_symbol	VARCHAR

query TT
SELECT title, regexp_extract(filename, '[^/]+$') FROM cifs.struct;
----
Only in c	c.cif

query TT rowsort
SELECT id, regexp_extract(filename, '[^/]+$') FROM cifs.entry;
----
a	a.cif
b	b.cif
c	c.cif

query TT rowsort
SELECT id, extra_b FROM cifs.entry;
----
a	NULL
b	B
c	NULL

query II rowsort
SELECT rowid, id FROM cifs.atom_site;
----
0	1
0	3
1	2
1	4

query T
SELECT path LIKE '%/multifile/*.cif' FROM duckdb_databases() WHERE database_name = 'cifs';
----
true

statement error
INSERT INTO cifs.atom_site (id) VALUES (5);
----
read-only

statement error
UPDATE cifs.atom_site SET id = 5;
----
read-only

statement error
DELETE FROM cifs.atom_site;
----
read-only

statement error
CREATE TABLE cifs.extra (id INTEGER);
----
read-only

statement ok
DETACH cifs;

statement error
ATTACH '__WORKING_DIRECTORY__/test/data/multifile/*.cif' AS writable (TYPE mmcif, READ_WRITE TRUE);
----
glob attachments are read-only

statement error
ATTACH '__TEST_DIR__/no_such_mmcif_*.cif' AS missing (TYPE mmcif);
----
No files found

query I
SELECT count(*) FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/multifile/*.cif', 'atom_site');
----
4

query IRT rowsort
SELECT id, Cartn_x, type_symbol FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/multifile/*.cif', 'atom_site');
----
1	1.5	NULL
2	2.5	NULL
3	NULL	O
4	NULL	N

# Explicit lists preserve file order. An exhausted empty loop must not end the scan.
query I
SELECT id FROM mmcif_scan(['__WORKING_DIRECTORY__/test/data/multifile/empty.cif', '__WORKING_DIRECTORY__/test/data/multifile/b.cif', '__WORKING_DIRECTORY__/test/data/multifile/a.cif'], 'atom_site');
----
3
4
1
2

query T rowsort
SELECT type_symbol FROM mmcif_scan(['__WORKING_DIRECTORY__/test/data/multifile/a.cif', '__WORKING_DIRECTORY__/test/data/multifile/b.cif'], 'atom_site');
----
N
NULL
NULL
O

query TI rowsort
SELECT regexp_extract(filename, '[^/]+$'), count(*) FROM mmcif_scan(['__WORKING_DIRECTORY__/test/data/multifile/[ab].cif', '__WORKING_DIRECTORY__/test/data/multifile/c*.cif'], 'atom_site') GROUP BY filename;
----
a.cif	2
b.cif	2

query TT
SELECT title, regexp_extract(filename, '[^/]+$') FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/multifile/*.cif', 'struct');
----
Only in c	c.cif

query I
SELECT id FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/multifile/*.cif', 'atom_site') LIMIT 1;
----
1

# More than one DuckDB vector, then a file transition.
statement ok
COPY (SELECT 'data_large' || chr(10) || 'loop_' || chr(10) || '_atom_site.id' || chr(10) || string_agg(i::VARCHAR, chr(10) ORDER BY i) AS content FROM range(5000) t(i)) TO '__TEST_DIR__/mmcif_multi_large.cif' (FORMAT CSV, HEADER false, QUOTE '');

query III
SELECT count(*), sum(id::BIGINT), count(Cartn_x) FROM mmcif_scan(['__TEST_DIR__/mmcif_multi_large.cif', '__WORKING_DIRECTORY__/test/data/multifile/a.cif'], 'atom_site');
----
5002	12497503	2

statement error
SELECT * FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/multifile/*.cif', 'absent');
----
not present in any matched file

statement error
SELECT * FROM mmcif_scan('__TEST_DIR__/no_such_mmcif_*.cif', 'atom_site');
----
No files found

# Single-file scans and glob attachments matching one file keep their original schema.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/multifile/a.cif', 'atom_site')) WHERE column_name = 'filename';
----
0

statement ok
ATTACH '__WORKING_DIRECTORY__/test/data/multifile/a*.cif' AS one (TYPE mmcif);

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'one' AND column_name = 'filename';
----
0

statement ok
DETACH one;

# Plain and compressed sources share the same scan path.
statement ok
COPY (SELECT content FROM read_text('__WORKING_DIRECTORY__/test/data/multifile/b.cif')) TO '__TEST_DIR__/mmcif_multi_b.cif.gz' (FORMAT CSV, HEADER false, QUOTE '', COMPRESSION gzip);

query IRT rowsort
SELECT id, Cartn_x, type_symbol FROM mmcif_scan(['__WORKING_DIRECTORY__/test/data/multifile/a.cif', '__TEST_DIR__/mmcif_multi_b.cif.gz'], 'atom_site');
----
1	1.5	NULL
2	2.5	NULL
3	NULL	O
4	NULL	N

# Apply block selection to every file in the input.
query TI rowsort
SELECT id, count(*) FROM mmcif_scan(['__WORKING_DIRECTORY__/test/data/mmcif_blocks.cif', '__WORKING_DIRECTORY__/test/data/mmcif_blocks.cif'], 'entry', data_block := 'Second') GROUP BY id;
----
Second	2

statement ok
COPY (SELECT content FROM read_text('__WORKING_DIRECTORY__/test/data/mmcif_blocks.cif')) TO '__TEST_DIR__/mmcif_multi_blocks.cif' (FORMAT CSV, HEADER false, QUOTE '');

statement ok
COPY (SELECT content FROM read_text('__WORKING_DIRECTORY__/test/data/mmcif_blocks.cif')) TO '__TEST_DIR__/mmcif_multi_blocks.cif.gz' (FORMAT CSV, HEADER false, QUOTE '', COMPRESSION gzip);

statement ok
ATTACH '__TEST_DIR__/mmcif_multi_blocks.cif*' AS blocks (TYPE mmcif, DATA_BLOCK 'Second');

query TI
SELECT id, count(*) FROM blocks.entry GROUP BY id;
----
Second	2

statement ok
DETACH blocks;

statement error
SELECT * FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/multifile/*.cif', 'entry', data_block := 'missing');
----
data block 'missing' not present in file

# Provenance must not shadow a real item named filename (case-insensitively).
statement ok
COPY (SELECT 'data_collision' || chr(10) || '_atom_site.FILENAME collision') TO '__TEST_DIR__/mmcif_multi_collision.cif' (FORMAT CSV, HEADER false, QUOTE '');

statement error
SELECT * FROM mmcif_scan(['__TEST_DIR__/mmcif_multi_collision.cif', '__WORKING_DIRECTORY__/test/data/multifile/a.cif'], 'atom_site');
----
already contains a filename column

statement ok
COPY (SELECT content FROM read_text('__WORKING_DIRECTORY__/test/data/multifile/a.cif')) TO '__TEST_DIR__/mmcif_multi_collision_other.cif' (FORMAT CSV, HEADER false, QUOTE '');

statement error
ATTACH '__TEST_DIR__/mmcif_multi_collision*.cif' AS collision (TYPE mmcif);
----
already contains a filename column

statement error
SELECT * FROM mmcif_scan([]::VARCHAR[], 'atom_site');
----
needs at least one file to read

statement error
SELECT * FROM mmcif_scan([NULL]::VARCHAR[], 'atom_site');
----
cannot take NULL input

# The attached file set and schema remain stable until detach/reattach.
statement ok
COPY (SELECT content FROM read_text('__WORKING_DIRECTORY__/test/data/multifile/a.cif')) TO '__TEST_DIR__/mmcif_snapshot_a.cif' (FORMAT CSV, HEADER false, QUOTE '');

statement ok
ATTACH '__TEST_DIR__/mmcif_snapshot_*.cif' AS snapshot (TYPE mmcif);

statement ok
COPY (SELECT content FROM read_text('__WORKING_DIRECTORY__/test/data/multifile/b.cif')) TO '__TEST_DIR__/mmcif_snapshot_b.cif' (FORMAT CSV, HEADER false, QUOTE '');

query I
SELECT count(*) FROM snapshot.atom_site;
----
2

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'snapshot' AND column_name IN ('filename', 'type_symbol');
----
0

statement ok
DETACH snapshot;

statement ok
ATTACH '__TEST_DIR__/mmcif_snapshot_*.cif' AS snapshot (TYPE mmcif);

query I
SELECT count(*) FROM snapshot.atom_site;
----
4

query I
SELECT count(DISTINCT filename) FROM snapshot.atom_site;
----
2

statement ok
DETACH snapshot;

# Integration with the existing structure/ligand/block fixtures.
query I
SELECT count(*) FROM mmcif_scan('__WORKING_DIRECTORY__/test/data/*.cif', 'atom_site');
----
440
